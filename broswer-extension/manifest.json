{
    "manifest_version": 3,
    "name": "MindLens AI",
    "version": "0.1.0",
    "description": "Analyze selected webpage text for depression-related language.",
    "action": {
        "default_title": "MindLens AI",
        "default_popup": "popup.html"
    },
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://127.0.0.1:8000/*"
    ]
}